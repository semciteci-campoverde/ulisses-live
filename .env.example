# Copie para .env apenas na máquina local. Não publique este arquivo com senhas reais.

# Servidor local (usado quando o Supabase não está configurado)
PORT=8787
DATA_DIR=./data
ADMIN_EMAIL=admin@eecm.local
ADMIN_PASSWORD=altere-esta-senha
# ADMIN_SYNC=1
# Defina ADMIN_SYNC=1 uma vez se quiser que a senha do .env substitua a já gravada.

# Opcional: moderação de TEXTO por um serviço compatível com a API da OpenAI.
# Sem estas variáveis, fotos e vídeos seguem só com revisão humana
# e as mensagens usam o filtro de regras + aprovação humana.
# Nunca coloque a chave no frontend.
# AI_API_KEY=
# AI_API_URL=https://api.openai.com/v1/chat/completions
# AI_MODEL=gpt-4o-mini

# Produção no Vercel/Netlify (frontend) + Supabase.
# Estas duas variáveis ligam o modo Supabase no navegador.
# VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# VITE_SUPABASE_ANON_KEY=sua-chave-anon
